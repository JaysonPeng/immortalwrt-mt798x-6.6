################################
# Target (MT6000)
################################
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt6000=y

################################
# System
################################
CONFIG_KERNEL_BUILD_USER="github"
CONFIG_KERNEL_BUILD_DOMAIN="actions"
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

################################
# LuCI 基础 + 中文
################################
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-all-zh-cn=y

################################
# WiFi (MT6000 必须)
################################
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

################################
# HomeProxy（中文）
################################
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

################################
# TurboACC（中文）
################################
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSFORWARDER=y

################################
# Broadband Acc（中文）
################################
CONFIG_PACKAGE_luci-app-broadbandacc=y
CONFIG_PACKAGE_luci-i18n-broadbandacc-zh-cn=y

################################
# iStore 商店（中文）
################################
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-i18n-store-zh-cn=y
CONFIG_PACKAGE_istoreos=y

################################
# UPnP（中文）
################################
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

################################
# TimeWOL（中文）
################################
CONFIG_PACKAGE_luci-app-timewol=y
CONFIG_PACKAGE_luci-i18n-timewol-zh-cn=y

################################
# HNAT / 硬件加速
################################
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_luci-app-hnat=y

################################
# 常用工具
################################
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_bash=y

################################
# 冲突项（确保未选）
################################
# CONFIG_PACKAGE_luci-app-sfe is not set
# CONFIG_PACKAGE_kmod-sfe is not set
# CONFIG_PACKAGE_podman is not set
